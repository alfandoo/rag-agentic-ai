# Copy to .env.prod on the VPS. Never commit the real file.
APP_DOMAIN=app.example.com
ACME_EMAIL=you@example.com

# LLM providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Search
TAVILY_API_KEY=

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=https://app.example.com
RATE_LIMIT_ENABLED=true
RESEARCH_RATE_LIMIT_PER_HOUR=5
RESEARCH_RATE_LIMIT_WINDOW_HOURS=5
RESEARCH_RATE_LIMIT_PER_DAY=20
CHAT_RATE_LIMIT_PER_HOUR=20

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=competitor_research

# Langfuse self-hosted (optional). With the langfuse-link overlay:
# LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
