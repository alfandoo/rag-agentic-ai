
# ========================================================
# Market & Competitor Intelligence Agent - Environment Setup
# ========================================================

# 1. Primary LLM (Google Gemini)
# Ambil API key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# 2. Fallback LLM Provider (Groq API - openai/gpt-oss-120b)
# Dapatkan gratis di: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 3. Search Tools
# Tavily API (Opsional tapi direkomendasikan): https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# 3. Observability & Tracing (Opsional untuk portofolio)
# Langfuse self-hosted (open source, bukan cloud). Start: docker compose -f docker-compose.langfuse.yml --env-file backend/.env up -d
# UI: http://localhost:3001. Key: string acak berawalan pk-lf- dan sk-lf-. Secret: openssl rand -hex 32 (ENCRYPTION_KEY harus 64 hex).
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@local.dev
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=

# 4. Vector Database Config (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=competitor_research

# 5. Backend Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000
